{
  "name": "bioquest",
  "version": "1.0.0",
  "description": "面向生物竞赛（联赛）备考的全栈学习平台，集知识卡片、模拟试题、学习分析、社区讨论于一体。",
  "scripts": {
    "test": "npm run test:anchor && npm run audit:design && npm run test:unit && npm run test:smoke",
    "test:unit": "jest --verbose --coverage",
    "test:smoke": "node tests/wiki-smoke-test.cjs",
    "test:e2e": "node tests/e2e-smoke.js",
    "test:anchor": "node scripts/verify-manifest-anchor.js",
    "lint:js": "git ls-files 'js/**/*.js' 'tests/*.js' 'tests/*.cjs' | xargs -n1 node --check",
    "audit:design": "node scripts/audit-design.js",
    "bump:sw": "node scripts/bump-sw.js",
    "build:css": "node scripts/build-css-bundle.js",
    "build:min": "node scripts/minify-assets.js",
    "gen:topics": "node scripts/generate-topic-pages.js",
    "indexnow": "node scripts/submit-indexnow.js",
    "indexnow:dry": "node scripts/submit-indexnow.js --dry-run",
    "baidu": "node scripts/submit-baidu.js",
    "baidu:dry": "node scripts/submit-baidu.js --dry-run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/astrnox/BioQuest.git"
  },
  "keywords": [],
  "author": "",
  "license": "MPL-2.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/astrnox/BioQuest/issues"
  },
  "homepage": "https://github.com/astrnox/BioQuest#readme",
  "devDependencies": {
    "agent-browser": "^0.31.1",
    "esbuild": "^0.24.2",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.63.0"
  }
}
