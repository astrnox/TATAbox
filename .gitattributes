microscope-3d/assets/*.js -whitespace
*.sql linguist-detectable=false
*.py linguist-detectable=false

# 题库分片要求跨平台字节一致：manifest 里存的是这些文件的 SHA-256，
# Windows 检出若转成 CRLF 会让 Linux CI / 线上校验全部失配。
# 强制工作区保持 LF（仓库内本来就是 LF）。
data/manifest.json text eol=lf
data/bank/** text eol=lf
data/index/** text eol=lf
data/questions/id-all.json text eol=lf

# js/css/data 参与 sw.js 缓存版本哈希：统一 LF，避免 Windows 检出
# 生成不同版本号（哈希按 git blob 计算，见 scripts/bump-sw.js）。
# 仅按扩展名限定，避免误伤 css/vendor 下的 woff2 等二进制资源。
*.js text eol=lf
*.css text eol=lf
*.json text eol=lf

# 大体积二进制资源走 Git LFS（H-05 体积治理）：
# 视频（~152MB）与 docs 下的真题/演示 PDF、MP4 不再以普通 blob 入库。
# 注意：部署环境（CI/托管平台）检出时必须拉取 LFS 对象，否则线上拿到的是指针文本。
videos/*.mp4 filter=lfs diff=lfs merge=lfs -text
docs/*.pdf filter=lfs diff=lfs merge=lfs -text
docs/**/*.pdf filter=lfs diff=lfs merge=lfs -text
docs/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
