# ============================================================
# BioQuest — .htaccess 安全配置
# 上传到站点根目录 bioquest.dada.im/
# ============================================================
# 如果服务器使用 Apache，此文件生效
# 如果使用 Nginx，需要手动配置 Nginx 规则
# 如果使用彩虹云自带 WAF，参考下方 WAF 正则
# ============================================================

# 禁止目录列表
Options -Indexes

# 默认首页
DirectoryIndex index.html

# ============================================================
# 禁止访问敏感文件类型
# ============================================================
<FilesMatch "\.(py|pyc|sql|env|md|yml|yaml|log|gitignore|editorconfig|DS_Store)$">
    Require all denied
</FilesMatch>

# 禁止访问隐藏文件（.env, .git 等）
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# 禁止访问敏感目录
RewriteEngine On
RewriteRule ^backend/ - [F,L]
RewriteRule ^__pycache__/ - [F,L]
RewriteRule ^sql/ - [F,L]
RewriteRule ^quiz_data/ - [F,L]
RewriteRule ^\.git/ - [F,L]
RewriteRule ^\.vscode/ - [F,L]
RewriteRule \.py$ - [F,L]
RewriteRule \.sql$ - [F,L]
RewriteRule \.env$ - [F,L]
RewriteRule \.yml$ - [F,L]
RewriteRule \.yaml$ - [F,L]
RewriteRule \.md$ - [F,L]

# ============================================================
# 安全 Header
# ============================================================
<IfModule mod_headers.c>
    # 防止 MIME 嗅探
    Header set X-Content-Type-Options "nosniff"
    # 防止点击劫持（与 Cloudflare _headers 的 DENY 对齐）
    Header set X-Frame-Options "DENY"
    # 禁止引用来源泄露
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # M-09：HSTS（HTTP 响应中浏览器会忽略，仅 HTTPS 生效）
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # Content-Security-Policy：限制脚本/样式/图片来源，防御 XSS
    # 注意：CSP 多策略按「交集」执行——index.html / lite.html 的 meta CSP 更严
    # （script-src 无 unsafe-inline），本响应头不会放宽它们。
    # 此处保留 script-src 'unsafe-inline' 仅为兼容 ebook.html / quiz.html 等
    # 尚未迁移内联 onclick 的历史入口页；新页面一律走 csp-events 的 data-on 委托。
    # M-05：Trusted Types 强制模式（已通过主路由 + 后台 tab + 社区交互实测）
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; img-src 'self' data: https: blob:; font-src 'self' data:; connect-src 'self' https://*.supabase.co https://api.deepseek.com https://api.siliconflow.cn https://open.bigmodel.cn https://api.minimax.chat https://dashscope.aliyuncs.com https://api.moonshot.cn https://integrate.api.nvidia.com https://metaso.cn https://raw.githubusercontent.com; frame-src 'self' https://phet.colorado.edu https://embed.diagrams.net; media-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; require-trusted-types-for 'script'; trusted-types dompurify default 'allow-duplicates'"
</IfModule>